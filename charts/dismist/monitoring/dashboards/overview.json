{
 "annotations": {
  "list": []
 },
 "description": "Access points, clients and controller health for dismist.",
 "editable": true,
 "fiscalYearStartMonth": 0,
 "graphTooltip": 1,
 "links": [
  {
   "icon": "dashboard",
   "targetBlank": false,
   "title": "Access point",
   "tooltip": "Per-AP dashboard",
   "type": "link",
   "url": "/d/dismist-ap?var-namespace=${namespace}&${__url_time_range}"
  }
 ],
 "liveNow": false,
 "panels": [
  {
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "id": 1,
   "panels": [],
   "title": "Status",
   "type": "row"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "description": "Access points connected to the controller now.",
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#3987e5",
        "value": null
       }
      ]
     },
     "unit": "none"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 0,
    "y": 1
   },
   "id": 2,
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "justifyMode": "auto",
    "orientation": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "value",
    "wideLayout": true
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum(dismist_ap_connected{namespace=\"$namespace\", site=~\"$site\"}) or vector(0)",
     "format": "time_series",
     "instant": true,
     "legendFormat": "__auto",
     "range": false,
     "refId": "A"
    }
   ],
   "title": "APs online",
   "type": "stat"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "description": "Access points registered in the selected sites.",
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#3987e5",
        "value": null
       }
      ]
     },
     "unit": "none"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 4,
    "y": 1
   },
   "id": 3,
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "justifyMode": "auto",
    "orientation": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "value",
    "wideLayout": true
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum(dismist_site_aps{namespace=\"$namespace\", site=~\"$site\"}) or vector(0)",
     "format": "time_series",
     "instant": true,
     "legendFormat": "__auto",
     "range": false,
     "refId": "A"
    }
   ],
   "title": "APs registered",
   "type": "stat"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "description": "Registered access points that are not connected.",
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#0ca30c",
        "value": null
       },
       {
        "color": "#d03b3b",
        "value": 1
       }
      ]
     },
     "unit": "none"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 8,
    "y": 1
   },
   "id": 4,
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "justifyMode": "auto",
    "orientation": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "value",
    "wideLayout": true
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "(sum(dismist_site_aps{namespace=\"$namespace\", site=~\"$site\"}) or vector(0)) - (sum(dismist_ap_connected{namespace=\"$namespace\", site=~\"$site\"}) or vector(0))",
     "format": "time_series",
     "instant": true,
     "legendFormat": "__auto",
     "range": false,
     "refId": "A"
    }
   ],
   "title": "APs offline",
   "type": "stat"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "description": "Clients associated to connected access points.",
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#3987e5",
        "value": null
       }
      ]
     },
     "unit": "none"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 12,
    "y": 1
   },
   "id": 5,
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "justifyMode": "auto",
    "orientation": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "value",
    "wideLayout": true
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum(dismist_site_associated_clients{namespace=\"$namespace\", site=~\"$site\"}) or vector(0)",
     "format": "time_series",
     "instant": true,
     "legendFormat": "__auto",
     "range": false,
     "refId": "A"
    }
   ],
   "title": "Wi-Fi clients",
   "type": "stat"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "description": "Access points whose applied configuration revision is older than the desired one.",
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#0ca30c",
        "value": null
       },
       {
        "color": "#fab219",
        "value": 1
       }
      ]
     },
     "unit": "none"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 16,
    "y": 1
   },
   "id": 6,
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "justifyMode": "auto",
    "orientation": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "value",
    "wideLayout": true
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "count((dismist_ap_desired_revision{namespace=\"$namespace\", site=~\"$site\"} - on (site, ap) dismist_ap_applied_revision{namespace=\"$namespace\", site=~\"$site\"}) > 0) or vector(0)",
     "format": "time_series",
     "instant": true,
     "legendFormat": "__auto",
     "range": false,
     "refId": "A"
    }
   ],
   "title": "APs behind config",
   "type": "stat"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "description": "Access point (re)connections in the last 24 hours. Config saves and controller restarts also cause them.",
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "decimals": 0,
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#0ca30c",
        "value": null
       },
       {
        "color": "#fab219",
        "value": 3
       },
       {
        "color": "#d03b3b",
        "value": 10
       }
      ]
     },
     "unit": "none"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 20,
    "y": 1
   },
   "id": 7,
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "justifyMode": "auto",
    "orientation": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "value",
    "wideLayout": true
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum(increase(dismist_ap_connections_total{namespace=\"$namespace\", site=~\"$site\"}[24h])) or vector(0)",
     "format": "time_series",
     "instant": true,
     "legendFormat": "__auto",
     "range": false,
     "refId": "A"
    }
   ],
   "title": "Reconnects (24h)",
   "type": "stat"
  },
  {
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 5
   },
   "id": 8,
   "panels": [],
   "title": "Access points",
   "type": "row"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "description": "One row per access point. Click a name for its dashboard.",
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Status"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "options": {
           "0": {
            "color": "#d03b3b",
            "index": 1,
            "text": "Offline"
           },
           "1": {
            "color": "#0ca30c",
            "index": 0,
            "text": "Online"
           }
          },
          "type": "value"
         }
        ]
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "mode": "basic",
         "type": "color-background"
        }
       },
       {
        "id": "color",
        "value": {
         "mode": "thresholds"
        }
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "#d03b3b",
           "value": null
          },
          {
           "color": "#0ca30c",
           "value": 1
          }
         ]
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Uptime"
      },
      "properties": [
       {
        "id": "unit",
        "value": "dtdurations"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Last message"
      },
      "properties": [
       {
        "id": "unit",
        "value": "s"
       },
       {
        "id": "decimals",
        "value": 0
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Config behind"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       },
       {
        "id": "color",
        "value": {
         "mode": "thresholds"
        }
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "#0ca30c",
           "value": null
          },
          {
           "color": "#fab219",
           "value": 1
          }
         ]
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Name"
      },
      "properties": [
       {
        "id": "links",
        "value": [
         {
          "title": "Access point dashboard",
          "url": "/d/dismist-ap?var-namespace=${namespace}&var-site=${__data.fields.site}&var-ap=${__data.fields[\"AP ID\"]}&${__url_time_range}"
         }
        ]
       }
      ]
     }
    ]
   },
   "gridPos": {
    "h": 7,
    "w": 24,
    "x": 0,
    "y": 6
   },
   "id": 9,
   "options": {
    "cellHeight": "sm",
    "footer": {
     "show": false
    },
    "showHeader": true
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "dismist_ap_info{namespace=\"$namespace\", site=~\"$site\"}",
     "format": "table",
     "instant": true,
     "legendFormat": "__auto",
     "range": false,
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "dismist_ap_connected{namespace=\"$namespace\", site=~\"$site\"}",
     "format": "table",
     "instant": true,
     "legendFormat": "__auto",
     "range": false,
     "refId": "B"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "dismist_ap_uptime_seconds{namespace=\"$namespace\", site=~\"$site\"}",
     "format": "table",
     "instant": true,
     "legendFormat": "__auto",
     "range": false,
     "refId": "C"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "dismist_ap_associated_clients{namespace=\"$namespace\", site=~\"$site\"}",
     "format": "table",
     "instant": true,
     "legendFormat": "__auto",
     "range": false,
     "refId": "D"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "time() - (dismist_ap_last_seen_timestamp_seconds{namespace=\"$namespace\", site=~\"$site\"} > 0)",
     "format": "table",
     "instant": true,
     "legendFormat": "__auto",
     "range": false,
     "refId": "E"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "dismist_ap_desired_revision{namespace=\"$namespace\", site=~\"$site\"} - on (site, ap) dismist_ap_applied_revision{namespace=\"$namespace\", site=~\"$site\"}",
     "format": "table",
     "instant": true,
     "legendFormat": "__auto",
     "range": false,
     "refId": "F"
    }
   ],
   "title": "Access points",
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Value #A": true,
       "__name__": true,
       "container": true,
       "endpoint": true,
       "instance": true,
       "job": true,
       "namespace": true,
       "pod": true,
       "service": true,
       "site": true
      },
      "indexByName": {
       "Value #B": 2,
       "Value #C": 4,
       "Value #D": 3,
       "Value #E": 5,
       "Value #F": 6,
       "ap": 1,
       "firmware": 8,
       "model": 7,
       "name": 0
      },
      "renameByName": {
       "Value #B": "Status",
       "Value #C": "Uptime",
       "Value #D": "Clients",
       "Value #E": "Last message",
       "Value #F": "Config behind",
       "ap": "AP ID",
       "firmware": "Firmware",
       "model": "Model",
       "name": "Name"
      }
     }
    }
   ],
   "type": "table"
  },
  {
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 13
   },
   "id": 10,
   "panels": [],
   "title": "Activity",
   "type": "row"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "description": "Associated clients on each access point.",
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "axisSoftMin": 0,
      "drawStyle": "line",
      "fillOpacity": 10,
      "lineWidth": 2,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "group": "A",
       "mode": "normal"
      }
     },
     "decimals": 0,
     "unit": "none"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 14
   },
   "id": 11,
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum by (ap, name) (dismist_ap_associated_clients{namespace=\"$namespace\", site=~\"$site\"} * on (site, ap) group_left (name) dismist_ap_info)",
     "format": "time_series",
     "instant": false,
     "legendFormat": "{{name}} {{ap}}",
     "range": true,
     "refId": "A"
    }
   ],
   "title": "Clients per AP",
   "type": "timeseries"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "description": "Connected (green) or offline (red) over time.",
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "custom": {
      "fillOpacity": 80,
      "lineWidth": 0
     },
     "mappings": [
      {
       "options": {
        "0": {
         "color": "#d03b3b",
         "index": 1,
         "text": "Offline"
        },
        "1": {
         "color": "#0ca30c",
         "index": 0,
         "text": "Online"
        }
       },
       "type": "value"
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#d03b3b",
        "value": null
       },
       {
        "color": "#0ca30c",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 14
   },
   "id": 12,
   "options": {
    "alignValue": "left",
    "legend": {
     "showLegend": false
    },
    "mergeValues": true,
    "rowHeight": 0.8,
    "showValue": "never",
    "tooltip": {
     "mode": "single"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "dismist_ap_connected{namespace=\"$namespace\", site=~\"$site\"} * on (site, ap) group_left (name) dismist_ap_info",
     "format": "time_series",
     "instant": false,
     "legendFormat": "{{name}} {{ap}}",
     "range": true,
     "refId": "A"
    }
   ],
   "title": "AP status",
   "type": "state-timeline"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "description": "Uptime the access point reports. A drop to zero is a reboot.",
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "axisSoftMin": 0,
      "drawStyle": "line",
      "fillOpacity": 10,
      "lineWidth": 2,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "group": "A",
       "mode": "none"
      }
     },
     "unit": "dtdurations"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 22
   },
   "id": 13,
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "dismist_ap_uptime_seconds{namespace=\"$namespace\", site=~\"$site\"} * on (site, ap) group_left (name) dismist_ap_info",
     "format": "time_series",
     "instant": false,
     "legendFormat": "{{name}} {{ap}}",
     "range": true,
     "refId": "A"
    }
   ],
   "title": "AP uptime",
   "type": "timeseries"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "description": "Access point connections per interval. Each config save currently reconnects the APs it changes.",
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "axisSoftMin": 0,
      "drawStyle": "bars",
      "fillOpacity": 60,
      "lineWidth": 2,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "group": "A",
       "mode": "none"
      }
     },
     "decimals": 0,
     "unit": "none"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 22
   },
   "id": 14,
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
