{
 "annotations": {
  "list": [
   {
    "builtIn": 1,
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "hide": true,
    "iconColor": "rgba(0, 211, 255, 1)",
    "name": "Annotations & Alerts",
    "type": "dashboard"
   }
  ]
 },
 "description": "Channel plan, utilisation and interference, and client signal and protocol mix over the selected access points.",
 "editable": true,
 "fiscalYearStartMonth": 0,
 "graphTooltip": 1,
 "links": [
  {
   "icon": "dashboard",
   "targetBlank": false,
   "title": "Overview",
   "tooltip": "All access points",
   "type": "link",
   "url": "/d/dismist-overview?var-namespace=${namespace}&${__url_time_range}"
  },
  {
   "icon": "dashboard",
   "targetBlank": false,
   "title": "Access point",
   "tooltip": "Per-AP dashboard",
   "type": "link",
   "url": "/d/dismist-ap?var-namespace=${namespace}&${__url_time_range}"
  }
 ],
 "liveNow": false,
 "panels": [
  {
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "id": 1,
   "panels": [],
   "title": "Channel plan",
   "type": "row"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "description": "Access radios only. APs on the same channel and band share airtime; the planned column is dismist's channel plan.",
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Width"
      },
      "properties": [
       {
        "id": "unit",
        "value": "MHz"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Noise"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "mode": "basic",
         "type": "color-text"
        }
       },
       {
        "id": "color",
        "value": {
         "mode": "thresholds"
        }
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "#0ca30c",
           "value": null
          },
          {
           "color": "#fab219",
           "value": -80
          }
         ]
        }
       },
       {
        "id": "unit",
        "value": "dBm"
       },
       {
        "id": "decimals",
        "value": 0
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Power"
      },
      "properties": [
       {
        "id": "unit",
        "value": "dBm"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Utilisation"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "mode": "basic",
         "type": "color-background"
        }
       },
       {
        "id": "color",
        "value": {
         "mode": "thresholds"
        }
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "#0ca30c",
           "value": null
          },
          {
           "color": "#fab219",
           "value": 0.5
          },
          {
           "color": "#d03b3b",
           "value": 0.7
          }
         ]
        }
       },
       {
        "id": "unit",
        "value": "percentunit"
       },
       {
        "id": "decimals",
        "value": 0
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Clients"
      },
      "properties": [
       {
        "id": "decimals",
        "value": 0
       }
      ]
     }
    ]
   },
   "gridPos": {
    "h": 8,
    "w": 24,
    "x": 0,
    "y": 1
   },
   "id": 2,
   "options": {
    "cellHeight": "sm",
    "footer": {
     "show": false
    },
    "showHeader": true
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "max by (site, ap, radio, band) (dismist_radio_channel{namespace=\"$namespace\", site=~\"$site\", ap=~\"$ap\", band!=\"scan\"}) * on (site, ap) group_left (name) max by (site, ap, name) (dismist_ap_info{namespace=\"$namespace\"})",
     "format": "table",
     "instant": true,
     "legendFormat": "__auto",
     "range": false,
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "max by (site, ap, radio, band) (dismist_radio_bandwidth_mhz{namespace=\"$namespace\", site=~\"$site\", ap=~\"$ap\", band!=\"scan\"}) * on (site, ap) group_left (name) max by (site, ap, name) (dismist_ap_info{namespace=\"$namespace\"})",
     "format": "table",
     "instant": true,
     "legendFormat": "__auto",
     "range": false,
     "refId": "B"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "max by (site, ap, radio, band) (dismist_radio_noise_floor_dbm{namespace=\"$namespace\", site=~\"$site\", ap=~\"$ap\", band!=\"scan\"}) * on (site, ap) group_left (name) max by (site, ap, name) (dismist_ap_info{namespace=\"$namespace\"})",
     "format": "table",
     "instant": true,
     "legendFormat": "__auto",
     "range": false,
     "refId": "C"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "max by (site, ap, radio, band) (dismist_radio_max_tx_power_dbm{namespace=\"$namespace\", site=~\"$site\", ap=~\"$ap\", band!=\"scan\"}) * on (site, ap) group_left (name) max by (site, ap, name) (dismist_ap_info{namespace=\"$namespace\"})",
     "format": "table",
     "instant": true,
     "legendFormat": "__auto",
     "range": false,
     "refId": "D"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "max by (site, ap, radio, band) (dismist_radio_channel_utilization_ratio{namespace=\"$namespace\", site=~\"$site\", ap=~\"$ap\", band!=\"scan\", type=\"all\"}) * on (site, ap) group_left (name) max by (site, ap, name) (dismist_ap_info{namespace=\"$namespace\"})",
     "format": "table",
     "instant": true,
     "legendFormat": "__auto",
     "range": false,
     "refId": "E"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "max by (site, ap, radio, band) (dismist_radio_clients{namespace=\"$namespace\", site=~\"$site\", ap=~\"$ap\", band!=\"scan\"}) * on (site, ap) group_left (name) max by (site, ap, name) (dismist_ap_info{namespace=\"$namespace\"})",
     "format": "table",
     "instant": true,
     "legendFormat": "__auto",
     "range": false,
     "refId": "F"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "(max by (site, ap, band) (dismist_radio_planned_channel{namespace=\"$namespace\", site=~\"$site\", ap=~\"$ap\"}) * on (site, ap, band) group_right () (max by (site, ap, radio, band) (dismist_radio_channel{namespace=\"$namespace\", site=~\"$site\", ap=~\"$ap\", band!=\"scan\"}) * 0 + 1)) * on (site, ap) group_left (name) max by (site, ap, name) (dismist_ap_info{namespace=\"$namespace\"})",
     "format": "table",
     "instant": true,
     "legendFormat": "__auto",
     "range": false,
     "refId": "G"
    }
   ],
   "title": "Channel plan",
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "container": true,
       "endpoint": true,
       "instance": true,
       "job": true,
       "namespace": true,
       "pod": true,
       "service": true,
       "site": true
      },
      "indexByName": {
       "Value #A": 4,
       "Value #B": 6,
       "Value #C": 8,
       "Value #D": 9,
       "Value #E": 7,
       "Value #F": 10,
       "Value #G": 5,
       "ap": 1,
       "band": 3,
       "name": 0,
       "radio": 2
      },
      "renameByName": {
       "Value #A": "Channel",
       "Value #B": "Width",
       "Value #C": "Noise",
       "Value #D": "Power",
       "Value #E": "Utilisation",
       "Value #F": "Clients",
       "Value #G": "Planned",
       "ap": "AP ID",
       "band": "Band (GHz)",
       "name": "AP",
       "radio": "Radio"
      }
     }
    }
   ],
   "type": "table"
  },
  {
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 9
   },
   "id": 3,
   "panels": [],
   "title": "Channels and interference",
   "type": "row"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "description": "How busy each access radio's channel is. Over 0.5 is busy, over 0.7 congested.",
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "axisSoftMin": 0,
      "drawStyle": "line",
      "fillOpacity": 10,
      "lineInterpolation": "linear",
      "lineWidth": 2,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "group": "A",
       "mode": "none"
      },
      "thresholdsStyle": {
       "mode": "line+area"
      }
     },
     "max": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#0ca30c",
        "value": null
       },
       {
        "color": "#fab219",
        "value": 0.5
       },
       {
        "color": "#d03b3b",
        "value": 0.7
       }
      ]
     },
     "unit": "percentunit"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 10
   },
   "id": 4,
   "interval": "1m",
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "max by (site, ap, name, radio, band) (dismist_radio_channel_utilization_ratio{namespace=\"$namespace\", site=~\"$site\", ap=~\"$ap\", band!=\"scan\", type=\"all\"} * on (site, ap) group_left (name) max by (site, ap, name) (dismist_ap_info{namespace=\"$namespace\"}))",
     "format": "time_series",
     "instant": false,
     "legendFormat": "{{name}} {{ap}} {{radio}} ({{band}} GHz)",
     "range": true,
     "refId": "A"
    }
   ],
   "title": "Channel utilisation",
   "type": "timeseries"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "description": "Airtime used by others, averaged over the selected access radios: neighbouring networks (rx_other_bss), Wi-Fi the radio cannot attribute, and non-Wi-Fi energy such as microwaves.",
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "axisSoftMin": 0,
      "drawStyle": "line",
      "fillOpacity": 40,
      "lineInterpolation": "linear",
      "lineWidth": 2,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "group": "A",
       "mode": "normal"
      }
     },
     "unit": "percentunit"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 10
   },
   "id": 5,
   "interval": "1m",
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "avg by (type) (dismist_radio_channel_utilization_ratio{namespace=\"$namespace\", site=~\"$site\", ap=~\"$ap\", band!=\"scan\", type=~\"rx_other_bss|unknown_wifi|non_wifi|undecodable_wifi\"})",
     "format": "time_series",
     "instant": false,
     "legendFormat": "{{type}}",
     "range": true,
     "refId": "A"
    }
   ],
   "title": "Interference",
   "type": "timeseries"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "description": "Noise floor per access radio. Above -80 dBm hurts every client.",
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 10,
      "lineInterpolation": "linear",
      "lineWidth": 2,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "group": "A",
       "mode": "none"
      },
      "thresholdsStyle": {
       "mode": "line+area"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#0ca30c",
        "value": null
       },
       {
        "color": "#fab219",
        "value": -80
       }
      ]
     },
     "unit": "dBm"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 18
   },
   "id": 6,
   "interval": "1m",
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "max by (site, ap, name, radio, band) (dismist_radio_noise_floor_dbm{namespace=\"$namespace\", site=~\"$site\", ap=~\"$ap\", band!=\"scan\"} * on (site, ap) group_left (name) max by (site, ap, name) (dismist_ap_info{namespace=\"$namespace\"}))",
     "format": "time_series",
     "instant": false,
     "legendFormat": "{{name}} {{ap}} {{radio}} ({{band}} GHz)",
     "range": true,
     "refId": "A"
    }
   ],
   "title": "Noise floor",
   "type": "timeseries"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "description": "Channel changes per hour: plan applies, DFS moves after radar.",
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "axisSoftMin": 0,
      "drawStyle": "bars",
      "fillOpacity": 60,
      "lineInterpolation": "linear",
      "lineWidth": 2,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "group": "A",
       "mode": "none"
      }
     },
     "decimals": 0,
     "unit": "none"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 18
   },
   "id": 7,
   "interval": "1m",
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum by (site, ap, name, radio, band) (changes(dismist_radio_channel{namespace=\"$namespace\", site=~\"$site\", ap=~\"$ap\", band!=\"scan\"}[1h]) * on (site, ap) group_left (name) max by (site, ap, name) (dismist_ap_info{namespace=\"$namespace\"}))",
     "format": "time_series",
     "instant": false,
     "legendFormat": "{{name}} {{ap}} {{radio}}",
     "range": true,
     "refId": "A"
    }
   ],
   "title": "Channel changes",
   "type": "timeseries"
  },
  {
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 26
   },
   "id": 8,
   "panels": [],
   "title": "Client quality",
   "type": "row"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "description": "Clients on each AP by signal: excellent -60 dBm or better, good to -67, fair to -75, poor below.",
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "decimals": 0,
     "min": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#3987e5",
        "value": null
       }
      ]
     },
     "unit": "none"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 10,
    "w": 8,
    "x": 0,
    "y": 27
   },
   "id": 9,
   "options": {
    "displayMode": "gradient",
    "namePlacement": "auto",
    "orientation": "horizontal",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "showUnfilled": true,
    "sizing": "auto",
    "valueMode": "color"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum by (site, ap, name, signal) (dismist_radio_clients_by_signal{namespace=\"$namespace\", site=~\"$site\", ap=~\"$ap\"} * on (site, ap) group_left (name) max by (site, ap, name) (dismist_ap_info{namespace=\"$namespace\"}))",
     "format": "time_series",
     "instant": true,
     "legendFormat": "{{name}} {{ap}} {{signal}}",
     "range": false,
     "refId": "A"
    }
   ],
   "title": "Clients by signal",
   "type": "bargauge"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "description": "Clients by Wi-Fi generation. Older b/g/n clients slow 2.4 GHz for everyone.",
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "axisSoftMin": 0,
      "drawStyle": "line",
      "fillOpacity": 40,
      "lineInterpolation": "linear",
      "lineWidth": 2,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "group": "A",
       "mode": "normal"
      }
     },
     "decimals": 0,
     "unit": "none"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 10,
    "w": 8,
    "x": 8,
    "y": 27
   },
   "id": 10,
   "interval": "1m",
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum by (protocol) (dismist_radio_clients_by_protocol{namespace=\"$namespace\", site=~\"$site\", ap=~\"$ap\"})",
     "format": "time_series",
     "instant": false,
     "legendFormat": "{{protocol}}",
     "range": true,
     "refId": "A"
    }
   ],
   "title": "Clients by protocol",
   "type": "timeseries"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "description": "Clients per WLAN over the selected APs.",
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "axisSoftMin": 0,
      "drawStyle": "line",
      "fillOpacity": 40,
      "lineInterpolation": "linear",
      "lineWidth": 2,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "group": "A",
       "mode": "normal"
      }
     },
     "decimals": 0,
     "unit": "none"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 10,
    "w": 8,
    "x": 16,
    "y": 27
   },
   "id": 11,
   "interval": "1m",
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum by (wlan) (dismist_wlan_clients{namespace=\"$namespace\", site=~\"$site\", ap=~\"$ap\"}) * on (wlan) group_left (name) max by (wlan, name) (dismist_wlan_info{namespace=\"$namespace\"})",
     "format": "time_series",
     "instant": false,
     "legendFormat": "{{name}} {{wlan}}",
     "range": true,
     "refId": "A"
    }
   ],
   "title": "Clients per WLAN",
   "type": "timeseries"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "description": "Signal of the weakest client on each access radio. Below -75 dBm that client is slow and slows the radio.",
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 10,
      "lineInterpolation": "linear",
      "lineWidth": 2,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "group": "A",
