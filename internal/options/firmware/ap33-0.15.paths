# AP33 apfw-0.15 config paths: every JSON path ep-control decodes from the
# controller's config (config.EPConfig), with its exact Go type and kind.
# Generated once by `dismist-gen paths` from the 0.15 type walk; field
# names and types only. Format: path<TAB>go type<TAB>kind.
# [] is a slice or array element, {} a map value. Kinds: bool int uint
# float string struct slice array map pointer custom (own JSON decoder)
# named (underlying kind unknown) raw interface.
ID	string	string
UUID	uuid.UUID	custom
Name	string	string
Timestamp	float64	float
NotModified	bool	bool
FailedRetryAfter	uint32	uint
OrgID	uuid.UUID	custom
SiteID	uuid.UUID	custom
MapID	uuid.UUID	custom
XYZ	[3]float64	array
